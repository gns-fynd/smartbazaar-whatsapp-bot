OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
META_ACCESS_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_ID=
META_GRAPH_VERSION=v25.0
# Read-only credential/phone checks; readiness degrades within 24 hours of expiry.
CHANNEL_CHECK_INTERVAL_SECONDS=300
WEBHOOK_VERIFY_TOKEN=
# Select `openwa` only for the temporary, unofficial linked-device POC. Meta remains the default.
CHANNEL_PROVIDER=meta
OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
SESSION_ENCRYPTION_KEY=
# Comma-separated tester numbers in international digits-only format. Empty denies all.
ALLOWED_WHATSAPP_NUMBERS=
JIOMART_APPLICATION_ID=685945f46c8c7aee3f3af605
# Optional: public storefront configuration is discovered at runtime when empty.
JIOMART_APPLICATION_TOKEN=
# Real JioMart cart changes and order placement for linked accounts. Both default off.
JIOMART_CART_WRITES=false
JIOMART_CHECKOUT=false
# Largest order total (INR) the bot may submit after customer confirmation.
CHECKOUT_MAX_TOTAL=1500
# Online JioPay payment via a bot-opened JioMart payment session (opens once per order).
JIOMART_ONLINE_PAYMENT=false
# Customer cancellation of a chat-placed order (documented Storefront route, unverified live).
JIOMART_ORDER_CANCEL=false
# Optional stable https origin for /pay links; empty uses the local ngrok agent's tunnel URL.
PUBLIC_BASE_URL=
# Bot WhatsApp number (digits) for the "Back to WhatsApp" button after payment.
WHATSAPP_DISPLAY_NUMBER=
ORDER_WATCH_INTERVAL_SECONDS=20
# How often the background loop proactively renews live sessions' JioMart access tokens.
SESSION_KEEPALIVE_INTERVAL_SECONDS=600
DATABASE_PATH=work/runtime/bot.sqlite3
SESSION_TTL_SECONDS=2592000
