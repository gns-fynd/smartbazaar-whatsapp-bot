diff --git a/src/config/poc-privacy.ts b/src/config/poc-privacy.ts
new file mode 100644
--- /dev/null
+++ b/src/config/poc-privacy.ts
@@ -0,0 +1,16 @@
+import type { ValueTransformer } from 'typeorm';
+
+/**
+ * Local-POC privacy mode. The gateway still delivers live webhook events, but it does not retain
+ * message bodies or webhook replay payloads. This trades crash recovery and local chat history
+ * content for keeping OTPs and other chat text out of durable gateway state.
+ */
+export function isPocPrivacyMode(env: NodeJS.ProcessEnv = process.env): boolean {
+  return env.OPENWA_POC_PRIVACY_MODE === 'true';
+}
+
+/** Redact message text at TypeORM's write boundary while leaving the live event object untouched. */
+export const PocPrivacyMessageBodyTransformer: ValueTransformer = {
+  to: (value: unknown) => (isPocPrivacyMode() && typeof value === 'string' ? '' : value),
+  from: (value: unknown) => value,
+};
